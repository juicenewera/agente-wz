# Servidor
PORT=3000
LOG_LEVEL=info

# openwa | meta
WHATSAPP_PROVIDER=openwa

# Modelo compatível com a API da OpenAI. Exemplos:
# OpenAI: https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AGENT_NAME=Assistente
BUSINESS_NAME=Minha Empresa
SYSTEM_PROMPT=Você é um assistente comercial prestativo. Responda em português, com clareza e concisão.
MAX_HISTORY_MESSAGES=20

# OpenWA / Easy API ou gateway compatível
OPENWA_URL=http://openwa:8080
OPENWA_API_KEY=
OPENWA_SESSION_ID=default
# Opcional: valida X-OpenWA-Signature em sha256=<hex>
OPENWA_WEBHOOK_SECRET=

# API oficial: WhatsApp Business Platform Cloud API
META_GRAPH_VERSION=v23.0
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=troque-este-token
# Usado para validar X-Hub-Signature-256. Não confundir com o access token.
META_APP_SECRET=
